# Runtime e banco PostgreSQL (Neon recomendado no Marketplace da Vercel)
DATABASE_URL=

# Uploads e mídia (Vercel Blob)
BLOB_READ_WRITE_TOKEN=

# URL canônica pública
NEXT_PUBLIC_SITE_URL=https://jornalbalcao.com.br
SITE_URL=https://jornalbalcao.com.br

# Bootstrap inicial. Usado somente quando portal_admins ainda estiver vazio.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Contas comerciais iniciais reais, se necessárias.
# Exemplo de formato: [{"email":"comercial@dominio.com","password":"senha-forte"}]
BOOTSTRAP_COMMERCIAL_ACCOUNTS_JSON=[]

# Identifica a implementação SMTP Node.js durante desenvolvimento local com Next.
APP_RUNTIME=vercel
