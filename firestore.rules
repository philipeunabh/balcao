rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Portal Public Listings
    match /portal_listings/{listingId} {
      allow read: if true;
      allow write: if request.auth != null || request.resource.data.userId != null;
    }

    // Portal Users
    match /portal_users/{userId} {
      allow read: if true;
      allow write: if true;
    }

    // Portal Virtual Stores
    match /portal_virtual_stores/{storeId} {
      allow read: if true;
      allow write: if true;
    }

    // Portal Store Listings
    match /portal_store_listings/{listingId} {
      allow read: if true;
      allow write: if true;
    }

    // Portal Chat Conversations & Messages
    match /portal_chat_conversations/{conversationId} {
      allow read, write: if true;
    }

    match /portal_chat_messages/{messageId} {
      allow read, write: if true;
    }

    // Portal Settings and general collections
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
